; Sarla introduction
; intro.srl

mdl cslio
mdl strs

[	[	> public main()|int
		> private putchrl(s|str)|bool
	] :=: flist|funx ; プロトタイプ宣言みたいなもん。強制。

	[	$800?
			cslio:outln('Invalid string interrupt")
			die(1) ; 死んどけintro.srl出来る
	] :=: trpTable|trap ; trapはこうやって対処するかも ... ? switch-caseみたいな、まぁそれでは無いのだけれど、で
						; 特に番号の規約は決めていない (如何せん2115もOSも開発完了なんてしてない為) から仮の400だけど

	; [	dat|str
	; 	id|int
	; ] :=: st|struct	; 構造体とかモジュールとか共用体とかenumとかは静的なブロック束縛だと思っているからこの書き方
						; あくまで書き方の例に挙げただけだからコメントアウトしてるけどね
						; 尚関数は動的だよ
	; [	dat + dat
	;	id + id
	; ] :=: @overRide 'st + st"	; こんな感じのオーバーライド構文と言うか、構造体の足し引きとかの定義が出来たらいいんだけれど
	; ただなぁ、じゃぁstruct+atherStructはどうすんのとかst+stはst+stでもst1+st2の場合加算順序で結果が変わるならどうすんのとか
	; 色々問題があるから入れるかどうかで言えば入れないとは思う、関数にしろって事で

	public main()|int ; 型名後置なのはそうでもしないと曖昧さが残るから。パイプで繋いでるのは丁度いい見た目をしてるから
	[	s|str	; 変数は基本同一スコープ以下でのみ参照可能 (上位スコープにある変数と同じ名前の変数名で変数アクセス先を一時上書き可能)
				; 上位スコープから下位スコープの変数を参照したいならその変数にdomを付ける (Domination) 。
				; s|str dom、s|str dom <- "str"って感じ。
				; dom変数は実質的なグローバル変数として機能する。完全な代替では無い。
				; dom変数は直接他の関数からアクセスすることは出来ない、やりたいならdomっている関数を呼び出して明示アクセスする必要性がある
				; それならdom要らねぇじゃんってなるけど、例えば返り値が内部宣言の配列だとしたら、その配列がret対象かどうかを調べる型推論擬き
				; を入れないといけなくなっちゃうからね。型推論はゴミだと思っている人間からすればdomで実質的なstaticにして、でもアクセスは関数
				; でって方が良いのよ
				; あとモジュール設計で変数アクセスを禁止、関数のみって言うAPIみたいな仕様にする以上モジュール内も揃っている方が扱い易いだろう
				; ってのもある

		to(true) ; while。if,for,whileは動的なブロック束縛だから後置にすると不味いのよ
		[	s <- cslio:in() ; 代入演算子って悩みの種だよねぇ ... <-記号はとてつもなく「代入です」の見た目なのだけれど。
							; でも比較演算子+負の数になると状況が悪化すると言う。どうしたものかねぇ。値には常に値であることを表す記号 ...
							; 例えば#で10進数、$で16進数を強制すれば対処できるんだけどねぇ。
							; まぁそれでいっかぁ。#-1。
			if(!strs:scmp(s, 'cmd_end_"))
				putchrl(s) ; 同じモジュール内の別の関数なら名前空間指定は要らない

			else
				end
		] cslio:outln('end of input")

		ret(#0)
	]

	private putchrl(s|str)|bool ; 関数はpublicを付けない限りprivateとでも思っていたのか？
	[	if(!strs:valid(s))
			trp($800)	; 割り込み―。215の奴。
						; Sarlaはインタプリタ実行については未定 (誰かがやってくれるだろ精神) 、
						; コンパイラを使えば215バイナリにアセンブルされて (215は独立してVMを用意するつもりだから此の儘でも実行出来る) 、
						; そこからネイティブにトランスされるからねぇ。
						; 基本的には215として実行じゃないかなぁ、移植性高いし。215は215で別プロジェクトとして開発を進めないとねぇ ...

		size|int <- strs:slen(s)

		for(i|int <- #0, i < size, i++)
		[	cslio:put(strs:getc(s, i)) ; s_iとしてはいけない、s_(#10)|chrとstr型は別物。配列アクセスs_iはエラー。
			cslio:out('\n")
		]

		ret(true)
	]
] :=: intro|mdl
; 流石にキャストをvChr%int (既にvChr|chrされてるとして) みたいにするのは露骨かなぁ？
; でも此れは既存の文法と同じ見た目をしていてくれるし、それでいて記号は全く違うからぱっと見で見分けられるし
; 何より既存のと同じなのがでかい気がする
; まぁつまり確定ではある
